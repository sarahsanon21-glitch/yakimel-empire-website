generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum PermissionScope {
  OWN
  DEPARTMENT
  ALL
}

enum EmployeeStatus {
  ACTIVE
  SUSPENDED
  INVITED
  DEACTIVATED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum AppStatus {
  LIVE
  DEVELOPMENT
  MAINTENANCE
  OFFLINE
}

enum ClientStatus {
  LEAD
  ACTIVE
  PAST
  ARCHIVED
}

enum ProjectStatus {
  LEAD
  CONSULTATION
  PROPOSAL
  CONTRACT
  DEPOSIT
  DESIGN
  DEVELOPMENT
  TESTING
  CLIENT_REVIEW
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  BLOCKED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MessageSourceType {
  WEBSITE_INQUIRY
  DIGIMARKET_SUPPORT
  HEALTHHYR_SUPPORT
  EZNOB
  DREAM_INK_DIGITALS
  INTERNAL_TEAM
  SYSTEM_ALERT
}

enum ConversationStatus {
  OPEN
  ASSIGNED
  PENDING
  RESOLVED
  CLOSED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CLIENT
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  LOGIN_FAILED
  PERMISSION_CHANGE
  EXPORT
}

// ============================================================
// COMPANY / ORG STRUCTURE
// ============================================================

model Company {
  id        String  @id @default(cuid())
  name      String
  legalName String?

  departments Department[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("companies")
}

model Department {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  parentDepartmentId String?
  parentDepartment   Department?  @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id])
  subDepartments     Department[] @relation("DepartmentHierarchy")

  name        String
  slug        String  @unique
  description String?

  employees Employee[]
  apps      App[]
  projects  Project[]
  tickets   SupportTicket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@map("departments")
}

// ============================================================
// AUTH / PBAC
// ============================================================

model Role {
  id          String  @id @default(cuid())
  name        String  @unique // Super Admin, Executive, Company Admin, Dept Manager, Employee, Finance, HR, IT Support
  description String?
  isSystem    Boolean @default(false)

  rolePermissions RolePermission[]
  employees       Employee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model Permission {
  id       String @id @default(cuid())
  resource String // e.g. "projects", "employees", "finance"
  action   String // e.g. "read", "write", "delete", "approve"

  rolePermissions RolePermission[]
  userOverrides   UserPermissionOverride[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  id           String          @id @default(cuid())
  roleId       String
  role         Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission      @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  scope        PermissionScope @default(OWN)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String

  // 2FA — mandatory, enforced at middleware level before dashboard access
  totpSecretEncrypted  String? // AES-256-GCM at rest
  totpEnabled          Boolean @default(false)
  backupCodesEncrypted String? // AES-256-GCM at rest, JSON array of hashed codes

  isActive    Boolean   @default(true)
  lastLoginAt DateTime?

  employee             Employee?
  sessions             Session[]
  loginHistory         LoginHistory[]
  auditLogs            AuditLog[]
  permissionOverrides  UserPermissionOverride[]
  sentInvitations      Invitation[]             @relation("InvitedBy")
  assignedTasks        Task[]                   @relation("TaskAssignee")
  managedProjects      Project[]                @relation("ProjectManager")
  conversationsHandled Conversation[]           @relation("ConversationHandledBy")
  ticketsAssigned      SupportTicket[]          @relation("TicketAssignee")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model UserPermissionOverride {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission      @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  scope        PermissionScope
  granted      Boolean         @default(true) // false = explicit deny override

  createdAt DateTime @default(now())

  @@unique([userId, permissionId])
  @@map("user_permission_overrides")
}

model Employee {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  fullName String
  title    String?
  status   EmployeeStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
  @@index([roleId])
  @@map("employees")
}

model Invitation {
  id           String @id @default(cuid())
  email        String
  roleId       String
  departmentId String

  invitedById String
  invitedBy   User   @relation("InvitedBy", fields: [invitedById], references: [id])

  tokenHash String           @unique
  status    InvitationStatus @default(PENDING)
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@map("invitations")
}

model Session {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash String    @unique
  ipAddress        String?
  userAgent        String?
  revokedAt        DateTime?
  expiresAt        DateTime

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

model LoginHistory {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  success   Boolean
  ipAddress String?
  userAgent String?
  reason    String? // e.g. "invalid_password", "2fa_failed"

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("login_history")
}

model AuditLog {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  action     AuditAction
  resource   String
  resourceId String?
  metadata   Json?

  ipAddress String?
  createdAt DateTime @default(now()) // append-only via Postgres trigger — no updatedAt

  @@index([userId])
  @@index([resource, resourceId])
  @@map("audit_logs")
}

// ============================================================
// ECOSYSTEM — APPS / PRODUCTS REGISTRY
// ============================================================

model App {
  id           String     @id @default(cuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  name        String  @unique // DigiMarketApp, HealthHyr, BrandForge AI, OmniPresence AI
  slug        String  @unique
  description String?
  domain      String? // digimarketapp.com, healthhyr.com

  status          AppStatus @default(DEVELOPMENT)
  progressPercent Int? // used while status = DEVELOPMENT

  apiKeyHash String? @unique // how this app authenticates its metrics push to Command Center

  metricSnapshots AppMetricSnapshot[]
  projects        Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
  @@map("apps")
}

model AppMetricSnapshot {
  id    String @id @default(cuid())
  appId String
  app   App    @relation(fields: [appId], references: [id], onDelete: Cascade)

  // Reported by each app's API contract, e.g. { "users": 12450, "orders": 327, "revenue": 4820.00, "errors": 0 }
  metrics Json

  capturedAt DateTime @default(now())

  @@index([appId, capturedAt])
  @@map("app_metric_snapshots")
}

// ============================================================
// CLIENTS / CRM
// ============================================================

model Client {
  id String @id @default(cuid())

  fullName String
  email    String  @unique
  phone    String?
  company  String?

  status ClientStatus @default(LEAD)
  source String? // website, referral, etc.

  projects      Project[]
  conversations Conversation[]
  tickets       SupportTicket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("clients")
}

// ============================================================
// PROJECTS / TASKS
// ============================================================

model Project {
  id String @id @default(cuid())

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  appId String?
  app   App?    @relation(fields: [appId], references: [id])

  name    String
  service String // website, app, software, etc.

  budget   Decimal?  @db.Decimal(12, 2)
  deposit  Decimal?  @db.Decimal(12, 2)
  deadline DateTime?

  status ProjectStatus @default(LEAD)

  projectManagerId String?
  projectManager   User?   @relation("ProjectManager", fields: [projectManagerId], references: [id])

  tasks Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([status])
  @@map("projects")
}

model Task {
  id String @id @default(cuid())

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title       String
  description String?

  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])

  priority TaskPriority @default(MEDIUM)
  status   TaskStatus   @default(TODO)
  dueDate  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([assigneeId])
  @@map("tasks")
}

// ============================================================
// MESSAGES / UNIFIED INBOX
// ============================================================

model Conversation {
  id String @id @default(cuid())

  source MessageSourceType
  status ConversationStatus @default(OPEN)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  subject String?

  assignedToId String?
  assignedTo   User?   @relation("ConversationHandledBy", fields: [assignedToId], references: [id])

  isPriority Boolean @default(false)

  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([source])
  @@index([status])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderName  String?
  senderEmail String?

  body String

  isInbound Boolean @default(true) // false = staff reply

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@map("messages")
}

// ============================================================
// SUPPORT TICKETS
// ============================================================

model SupportTicket {
  id String @id @default(cuid())

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  subject     String
  description String

  priority TicketPriority @default(MEDIUM)
  status   TicketStatus   @default(OPEN)

  assigneeId String?
  assignee   User?   @relation("TicketAssignee", fields: [assigneeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([departmentId])
  @@map("support_tickets")
}
